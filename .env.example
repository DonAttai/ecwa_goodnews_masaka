# Auth (required) — generate with: openssl rand -base64 48
# Must be 32+ chars, validated at boot by lib/env.ts
JWT_SECRET=change-me-to-32-plus-random-chars
JWT_EXPIRES_IN=7d
COOKIE_NAME=session

# App URL (used for email links, metadata)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Cloudinary ($0 free tier) — uploads for passports / flyers / receipts
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_API_KEY=
# server side only — never expose with NEXT_PUBLIC_
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Database — Neon / Supabase Postgres ($0 free tier is enough for a small church)
# Prisma 7 uses DIRECT_URL for migrations, DATABASE_URL (pooled) at runtime.
DATABASE_URL=postgresql://user:password@host:5432/db?pgbouncer=true
DIRECT_URL=postgresql://user:password@host:5432/db

# Local Postgres via compose.yml (optional dev alternative)
POSTGRES_USER=ecwa
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ecwa_goodnews

# Resend ($0 free: 3,000/mo, 100/day)
RESEND_API_KEY=
RESEND_FROM=ECWA Goodnews <no-reply@yourdomain.com>

# Web Push VAPID ($0, no service) — generate with: pnpm dlx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ecwagoodnews1masaka@protonmail.com

# CI only — skips strict env validation for lint/typecheck
# SKIP_ENV_VALIDATION=1
